# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=bit_bio_django
DB_USER=root
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=3306

# Security Settings
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_AGE=3600
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# Admin Configuration
ADMIN_SITE_HEADER=🧬 BitBio Administration
ADMIN_SITE_TITLE=BitBio Admin Portal
ADMIN_INDEX_TITLE=Welcome to BitBio Administration
ADMIN_LOGIN_REDIRECT_URL=/admin/
ADMIN_LOGOUT_REDIRECT_URL=/

# Application URLs
LOGIN_URL=/

# Internationalization
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
USE_I18N=True
USE_TZ=True

# Static Files
STATIC_URL=static/
